datasource db { provider = "postgresql" url = env("DATABASE_URL") }
generator client { provider = "prisma-client-js" }
model User { id String @id @default(cuid()) email String @unique name String? orders Order[] createdAt DateTime @default(now()) }
model Product { id String @id @default(cuid()) slug String @unique name String priceCents Int roastLevel String origin String stock Int images String[] }
model Order { id String @id @default(cuid()) user User @relation(fields: [userId], references: [id]) userId String status String totalCents Int stripePaymentId String? items OrderItem[] createdAt DateTime @default(now()) }
model OrderItem { id String @id @default(cuid()) order Order @relation(fields: [orderId], references: [id]) orderId String productId String qty Int priceCents Int }
